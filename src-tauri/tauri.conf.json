{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Azuria Launcher",
  "version": "0.1.0",
  "identifier": "com.azuria.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Azuria Launcher",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 650,
        "backgroundColor": "#10121c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Your next adventure, beautifully organised.",
    "category": "Game"
  }
}
