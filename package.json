{
  "name": "azuria-launcher",
  "version": "0.1.0",
  "description": "Azuria Minecraft Java desktop launcher",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "format": "prettier --write src tests docs README.md index.html *.ts *.json .github/workflows/*.yml src-tauri/*.json src-tauri/capabilities/*.json",
    "format:check": "prettier --check src tests docs README.md index.html *.ts *.json .github/workflows/*.yml src-tauri/*.json src-tauri/capabilities/*.json"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.55.0",
    "@tauri-apps/api": "^2.12.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "private": true
}
