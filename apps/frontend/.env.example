
# Optional GA4 web stream ID. Leave empty to disable analytics.
AZURIA_GA_MEASUREMENT_ID=

# Public news feed. Export these when building locally; this static build does not load .env.
AZURIA_SUPABASE_URL=
AZURIA_SUPABASE_PUBLISHABLE_KEY=
AZURIA_SITE_URL=https://launcher.azuriasmp.org/

# Optional public verification token from Google Search Console, not a tag snippet.
AZURIA_GOOGLE_SITE_VERIFICATION=
