
# Optional GA4 web stream ID. Leave empty to disable analytics.
AZURIA_GA_MEASUREMENT_ID=

# Anonymous launcher survey (public values, safe in the built website).
AZURIA_SUPABASE_URL=
AZURIA_SUPABASE_PUBLISHABLE_KEY=
AZURIA_TURNSTILE_SITE_KEY=

# Optional SEO settings. Production defaults to https://www.azuriasmp.org/.
AZURIA_SITE_URL=https://www.azuriasmp.org/
# Public verification token from Google Search Console (not the full HTML tag).
AZURIA_GOOGLE_SITE_VERIFICATION=
