# Set in Supabase Edge Function secrets, never in Vercel VITE_* variables.
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in hosted functions.
AZURIA_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
AZURIA_ACCOUNT_ORIGINS=https://accounts.azuriasmp.org
# For local website testing, append ,http://localhost:1421

# Server secrets only; Resend key must permit contact reads and writes.
RESEND_API_KEY=re_YOUR_API_KEY
MARKETING_SYNC_SECRET=YOUR_RANDOM_SECRET

# Survey bot protection. Store the secret only in Supabase Edge Function secrets.
AZURIA_TURNSTILE_SECRET_KEY=
AZURIA_FEEDBACK_ORIGINS=https://azuriasmp.org,https://www.azuriasmp.org
